{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "config_id",
    "version",
    "default_profile",
    "agents",
    "model_policy",
    "subagent_policy",
    "workflow",
    "execution",
    "approval_matrix",
    "delivery_actions",
    "runtime",
    "context_budget",
    "security",
    "skill_routing"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        5
      ]
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "default_profile": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "object"
    },
    "model_policy": {
      "type": "object"
    },
    "workflow": {
      "type": "object",
      "required": [
        "depth_order",
        "focused_max_files",
        "standard_max_files",
        "focused_max_concerns",
        "focused_max_repair_cycles",
        "standard_max_repair_cycles",
        "controlled_max_repair_cycles",
        "high_risk_flags",
        "standard_flags",
        "risk_approval_map",
        "legacy_change_type_routes"
      ],
      "properties": {
        "depth_order": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "focused",
              "standard",
              "controlled"
            ]
          }
        },
        "focused_max_files": {
          "type": "integer",
          "minimum": 0
        },
        "standard_max_files": {
          "type": "integer",
          "minimum": 1
        },
        "focused_max_concerns": {
          "type": "integer",
          "minimum": 1
        },
        "focused_max_repair_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "standard_max_repair_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "controlled_max_repair_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "high_risk_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "standard_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_approval_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "legacy_change_type_routes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "parallel_read_only_enabled",
        "max_parallel_read_only",
        "automatic_merge"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "sync"
          ]
        },
        "parallel_read_only_enabled": {
          "type": "boolean"
        },
        "max_parallel_read_only": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "automatic_merge": {
          "type": "boolean",
          "enum": [
            false
          ]
        }
      },
      "additionalProperties": false
    },
    "approval_matrix": {
      "type": "object",
      "required": [
        "normal_change",
        "new_dependency",
        "schema_change",
        "destructive_operation",
        "architecture_change",
        "public_api_change",
        "security_sensitive",
        "production_action"
      ],
      "properties": {
        "normal_change": {
          "type": "string",
          "enum": [
            "automatic",
            "user"
          ]
        },
        "new_dependency": {
          "type": "string",
          "enum": [
            "automatic",
            "user"
          ]
        },
        "schema_change": {
          "type": "string",
          "enum": [
            "automatic",
            "user"
          ]
        },
        "destructive_operation": {
          "type": "string",
          "enum": [
            "automatic",
            "user"
          ]
        },
        "architecture_change": {
          "type": "string",
          "enum": [
            "automatic",
            "user"
          ]
        },
        "public_api_change": {
          "type": "string",
          "enum": [
            "automatic",
            "user"
          ]
        },
        "security_sensitive": {
          "type": "string",
          "enum": [
            "automatic",
            "user"
          ]
        },
        "production_action": {
          "type": "string",
          "enum": [
            "automatic",
            "user"
          ]
        }
      },
      "additionalProperties": false
    },
    "delivery_actions": {
      "type": "object",
      "required": [
        "none",
        "keep_local",
        "merge_local",
        "push_branch",
        "create_review_request",
        "production_action",
        "destructive_cleanup"
      ],
      "additionalProperties": false,
      "properties": {
        "none": {
          "type": "object",
          "required": [
            "approval_key",
            "outcome",
            "cleanup"
          ],
          "properties": {
            "approval_key": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "NO_ACTION",
                "KEEP_LOCAL",
                "MERGE_LOCAL",
                "PUSH_BRANCH",
                "CREATE_REVIEW_REQUEST",
                "PRODUCTION_ACTION",
                "DESTRUCTIVE_CLEANUP"
              ]
            },
            "cleanup": {
              "type": "string",
              "enum": [
                "KEEP",
                "SAFE_REMOVE",
                "NOT_APPLICABLE"
              ]
            }
          },
          "additionalProperties": false
        },
        "keep_local": {
          "type": "object",
          "required": [
            "approval_key",
            "outcome",
            "cleanup"
          ],
          "properties": {
            "approval_key": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "NO_ACTION",
                "KEEP_LOCAL",
                "MERGE_LOCAL",
                "PUSH_BRANCH",
                "CREATE_REVIEW_REQUEST",
                "PRODUCTION_ACTION",
                "DESTRUCTIVE_CLEANUP"
              ]
            },
            "cleanup": {
              "type": "string",
              "enum": [
                "KEEP",
                "SAFE_REMOVE",
                "NOT_APPLICABLE"
              ]
            }
          },
          "additionalProperties": false
        },
        "merge_local": {
          "type": "object",
          "required": [
            "approval_key",
            "outcome",
            "cleanup"
          ],
          "properties": {
            "approval_key": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "NO_ACTION",
                "KEEP_LOCAL",
                "MERGE_LOCAL",
                "PUSH_BRANCH",
                "CREATE_REVIEW_REQUEST",
                "PRODUCTION_ACTION",
                "DESTRUCTIVE_CLEANUP"
              ]
            },
            "cleanup": {
              "type": "string",
              "enum": [
                "KEEP",
                "SAFE_REMOVE",
                "NOT_APPLICABLE"
              ]
            }
          },
          "additionalProperties": false
        },
        "push_branch": {
          "type": "object",
          "required": [
            "approval_key",
            "outcome",
            "cleanup"
          ],
          "properties": {
            "approval_key": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "NO_ACTION",
                "KEEP_LOCAL",
                "MERGE_LOCAL",
                "PUSH_BRANCH",
                "CREATE_REVIEW_REQUEST",
                "PRODUCTION_ACTION",
                "DESTRUCTIVE_CLEANUP"
              ]
            },
            "cleanup": {
              "type": "string",
              "enum": [
                "KEEP",
                "SAFE_REMOVE",
                "NOT_APPLICABLE"
              ]
            }
          },
          "additionalProperties": false
        },
        "create_review_request": {
          "type": "object",
          "required": [
            "approval_key",
            "outcome",
            "cleanup"
          ],
          "properties": {
            "approval_key": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "NO_ACTION",
                "KEEP_LOCAL",
                "MERGE_LOCAL",
                "PUSH_BRANCH",
                "CREATE_REVIEW_REQUEST",
                "PRODUCTION_ACTION",
                "DESTRUCTIVE_CLEANUP"
              ]
            },
            "cleanup": {
              "type": "string",
              "enum": [
                "KEEP",
                "SAFE_REMOVE",
                "NOT_APPLICABLE"
              ]
            }
          },
          "additionalProperties": false
        },
        "production_action": {
          "type": "object",
          "required": [
            "approval_key",
            "outcome",
            "cleanup"
          ],
          "properties": {
            "approval_key": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "NO_ACTION",
                "KEEP_LOCAL",
                "MERGE_LOCAL",
                "PUSH_BRANCH",
                "CREATE_REVIEW_REQUEST",
                "PRODUCTION_ACTION",
                "DESTRUCTIVE_CLEANUP"
              ]
            },
            "cleanup": {
              "type": "string",
              "enum": [
                "KEEP",
                "SAFE_REMOVE",
                "NOT_APPLICABLE"
              ]
            }
          },
          "additionalProperties": false
        },
        "destructive_cleanup": {
          "type": "object",
          "required": [
            "approval_key",
            "outcome",
            "cleanup"
          ],
          "properties": {
            "approval_key": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "NO_ACTION",
                "KEEP_LOCAL",
                "MERGE_LOCAL",
                "PUSH_BRANCH",
                "CREATE_REVIEW_REQUEST",
                "PRODUCTION_ACTION",
                "DESTRUCTIVE_CLEANUP"
              ]
            },
            "cleanup": {
              "type": "string",
              "enum": [
                "KEEP",
                "SAFE_REMOVE",
                "NOT_APPLICABLE"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "focused_state",
        "standard_state",
        "controlled_state"
      ],
      "properties": {
        "focused_state": {
          "type": "string",
          "enum": [
            "off",
            "optional",
            "required"
          ]
        },
        "standard_state": {
          "type": "string",
          "enum": [
            "off",
            "optional",
            "required"
          ]
        },
        "controlled_state": {
          "type": "string",
          "enum": [
            "off",
            "optional",
            "required"
          ]
        }
      },
      "additionalProperties": false
    },
    "context_budget": {
      "type": "object",
      "required": [
        "focused_max_files",
        "standard_max_files",
        "controlled_max_files",
        "max_bytes",
        "allow_unbounded_scan"
      ],
      "properties": {
        "focused_max_files": {
          "type": "integer",
          "minimum": 1
        },
        "standard_max_files": {
          "type": "integer",
          "minimum": 1
        },
        "controlled_max_files": {
          "type": "integer",
          "minimum": 1
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "allow_unbounded_scan": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [
        "redact_environment_values",
        "redact_tokens",
        "forbid_secret_persistence"
      ],
      "properties": {
        "redact_environment_values": {
          "type": "boolean"
        },
        "redact_tokens": {
          "type": "boolean"
        },
        "forbid_secret_persistence": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "skill_routing": {
      "type": "object",
      "required": [
        "process_skills",
        "required_companion_skills",
        "role_skills",
        "task_routes"
      ],
      "properties": {
        "process_skills": {
          "type": "object",
          "required": [
            "core",
            "debug",
            "verify"
          ]
        },
        "required_companion_skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "role_skills": {
          "type": "object",
          "required": [
            "brainstorm",
            "plan",
            "plan_review",
            "explore",
            "implement",
            "review",
            "batch_review",
            "recovery",
            "delivery",
            "skill_authoring"
          ]
        },
        "task_routes": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "subagent_policy": {
      "type": "object",
      "required": [
        "primary_skill",
        "fresh_context_per_dispatch",
        "synthesized_fallback",
        "one_writer_per_file_per_wave",
        "wait",
        "dispatchable_stages",
        "depths"
      ],
      "properties": {
        "primary_skill": {
          "type": "string",
          "minLength": 1
        },
        "fresh_context_per_dispatch": {
          "type": "boolean"
        },
        "synthesized_fallback": {
          "type": "boolean"
        },
        "one_writer_per_file_per_wave": {
          "type": "boolean"
        },
        "wait": {
          "type": "object",
          "required": [
            "check_interval_seconds",
            "timeout_seconds",
            "close_on_timeout"
          ],
          "properties": {
            "check_interval_seconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 300
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 86400
            },
            "close_on_timeout": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "dispatchable_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depths": {
          "type": "object",
          "required": [
            "focused",
            "standard",
            "controlled"
          ],
          "additionalProperties": false,
          "properties": {
            "focused": {
              "type": "object",
              "required": [
                "max_active",
                "max_total",
                "max_parallel_writers",
                "max_repair_rounds"
              ],
              "additionalProperties": false,
              "properties": {
                "max_active": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                },
                "max_total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "max_parallel_writers": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                },
                "max_repair_rounds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                }
              }
            },
            "standard": {
              "type": "object",
              "required": [
                "max_active",
                "max_total",
                "max_parallel_writers",
                "max_repair_rounds"
              ],
              "additionalProperties": false,
              "properties": {
                "max_active": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                },
                "max_total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "max_parallel_writers": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                },
                "max_repair_rounds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                }
              }
            },
            "controlled": {
              "type": "object",
              "required": [
                "max_active",
                "max_total",
                "max_parallel_writers",
                "max_repair_rounds"
              ],
              "additionalProperties": false,
              "properties": {
                "max_active": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                },
                "max_total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "max_parallel_writers": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                },
                "max_repair_rounds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
