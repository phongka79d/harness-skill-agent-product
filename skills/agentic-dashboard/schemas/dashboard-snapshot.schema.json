{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "as_of", "stale_after_seconds", "source", "redaction", "views", "diagnostics"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "as_of": {"type": "string", "minLength": 1},
    "stale_after_seconds": {"type": "integer", "minimum": 0},
    "source": {
      "type": "object",
      "required": ["runtime_revision", "files"],
      "properties": {
        "runtime_revision": {"type": "integer", "minimum": 0},
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "redaction": {
      "type": "object",
      "required": ["configured_keys", "effective_keys", "replacement"],
      "properties": {
        "configured_keys": {"type": "array", "items": {"type": "string"}},
        "effective_keys": {"type": "array", "items": {"type": "string"}},
        "replacement": {"type": "string", "minLength": 1}
      }
    },
    "views": {
      "type": "object",
      "required": ["queue", "state_history", "reviews", "locks", "leases", "recovery", "events"],
      "properties": {
        "queue": {"type": "object"},
        "state_history": {"type": "object"},
        "reviews": {"type": "object"},
        "locks": {"type": "object"},
        "leases": {"type": "object"},
        "recovery": {"type": "object"},
        "events": {"type": "object"}
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "path", "detail"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
