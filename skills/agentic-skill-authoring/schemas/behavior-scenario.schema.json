{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {"$ref": "#/$defs/scenario"},
    {"$ref": "#/$defs/suite"},
    {"$ref": "#/$defs/pressure_suite"}
  ],
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["schema_version", "scenario_id", "title", "owning_skill", "pressure", "prompt", "expected_behaviors", "forbidden_behaviors", "required_evidence", "expected_result", "assertions"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "scenario_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "title": {"type": "string", "minLength": 1},
        "owning_skill": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "pressure": {"$ref": "#/$defs/pressure"},
        "prompt": {"type": "string", "minLength": 1},
        "expected_behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected_result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]},
        "rationalizations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "profile_guidance": {"$ref": "#/$defs/profile_guidance"},
        "assertions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/assertion"}},
        "execution": {"$ref": "#/$defs/execution"}
      },
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": ["schema_version", "suite_id", "scenarios"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "suite_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scenario"}},
        "model": {"type": "string", "minLength": 1},
        "config": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "minLength": 1},
        "execution_results": {"type": "array", "items": {"$ref": "#/$defs/execution_result"}}
      },
      "additionalProperties": false
    },
    "pressure_suite": {
      "type": "object",
      "required": ["schema_version", "scenario_set_id", "description", "runner", "result_contract", "scenarios"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "scenario_set_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "description": {"type": "string", "minLength": 1},
        "runner": {"$ref": "#/$defs/runner_contract"},
        "result_contract": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/pressure_scenario"}}
      },
      "additionalProperties": false
    },
    "runner_contract": {
      "type": "object",
      "required": ["schema", "command", "model_selection", "record_fields"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "model_selection": {"type": "string", "minLength": 1},
        "record_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "pressure_scenario": {
      "type": "object",
      "required": ["id", "name", "pressure", "prompt", "expected", "forbidden"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "name": {"type": "string", "minLength": 1},
        "pressure": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "expected": {"$ref": "#/$defs/pressure_expected"},
        "forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "pressure_expected": {
      "type": "object",
      "required": ["scenario_result", "agent_action", "evidence"],
      "properties": {
        "scenario_result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]},
        "agent_action": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "pressure": {
      "type": "object",
      "required": ["type", "rationalization", "ambiguity", "risk"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "rationalization": {"type": "string", "minLength": 1},
        "ambiguity": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "profile_guidance": {
      "type": "object",
      "required": ["low_risk", "strict"],
      "properties": {
        "low_risk": {"type": "string", "minLength": 1},
        "strict": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["assertion_id", "description", "expected"],
      "properties": {
        "assertion_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "description": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "enum": ["OBSERVED", "ABSENT", "PRESENT"]}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["status", "model", "config", "evaluated_at"],
      "properties": {
        "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]},
        "result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]},
        "model": {"type": "string", "minLength": 1},
        "config": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "minLength": 1},
        "observed_behaviors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rationalizations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_location": {"type": "string", "minLength": 1},
        "model_ref": {"type": "string", "minLength": 1},
        "deployment_ref": {"type": "string", "minLength": 1},
        "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exit_code": {"type": "integer", "minimum": 0},
        "assertions": {"type": "object"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "execution_result": {
      "type": "object",
      "required": ["scenario_id", "status", "model", "config", "evaluated_at"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]},
        "result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]},
        "model": {"type": "string", "minLength": 1},
        "config": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "minLength": 1},
        "observed_behaviors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rationalizations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_location": {"type": "string", "minLength": 1},
        "model_ref": {"type": "string", "minLength": 1},
        "deployment_ref": {"type": "string", "minLength": 1},
        "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exit_code": {"type": "integer", "minimum": 0},
        "assertions": {"type": "object"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
