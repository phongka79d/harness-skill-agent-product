{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_decision_hash",
    "task_bindings",
    "evidence_requirements",
    "action",
    "outcome",
    "summary",
    "approval_required",
    "approval_kind",
    "approval_reference",
    "cleanup"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        4
      ]
    },
    "workflow_decision_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "task_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "work_revision",
          "workflow_decision_hash"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
          },
          "work_revision": {
            "type": "integer",
            "minimum": 1
          },
          "workflow_decision_hash": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_requirements": {
      "type": "object",
      "required": [
        "verification",
        "review",
        "batch_review"
      ],
      "properties": {
        "verification": {
          "type": "boolean"
        },
        "review": {
          "type": "boolean"
        },
        "batch_review": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "string",
      "enum": [
        "none",
        "keep_local",
        "merge_local",
        "push_branch",
        "create_review_request",
        "production_action",
        "destructive_cleanup"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "NO_ACTION",
        "KEEP_LOCAL",
        "MERGE_LOCAL",
        "PUSH_BRANCH",
        "CREATE_REVIEW_REQUEST",
        "PRODUCTION_ACTION",
        "DESTRUCTIVE_CLEANUP"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_kind": {
      "type": "string",
      "enum": [
        "automatic",
        "user"
      ]
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "cleanup": {
      "type": "string",
      "enum": [
        "KEEP",
        "SAFE_REMOVE",
        "NOT_APPLICABLE"
      ]
    }
  },
  "additionalProperties": false
}
