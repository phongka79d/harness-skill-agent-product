{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "subagent_wait"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "subagent_wait": {
      "type": "object",
      "required": [
        "check_interval_seconds",
        "timeout_seconds",
        "close_on_timeout"
      ],
      "properties": {
        "check_interval_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "close_on_timeout": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
