{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "subagent_wait",
    "execution",
    "primary_agent_fallback"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "subagent_wait": {
      "type": "object",
      "required": [
        "check_interval_seconds",
        "timeout_seconds",
        "close_on_timeout"
      ],
      "properties": {
        "check_interval_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "close_on_timeout": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "dispatch_timeout_seconds",
        "max_active_subagents"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "sync",
            "async"
          ]
        },
        "dispatch_timeout_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "max_active_subagents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "additionalProperties": false
    },
    "primary_agent_fallback": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
