{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["lock_id", "kind", "key", "owner", "run_id", "acquired_at", "expires_at", "lease_seconds"],
  "properties": {
    "lock_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["task", "file", "resource"]},
    "key": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "owner_pid": {"type": "integer", "minimum": 1},
    "owner_identity": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "acquired_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "lease_seconds": {"type": "integer", "minimum": 1}
  }
}
