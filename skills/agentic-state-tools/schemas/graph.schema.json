{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "graph_id", "revision", "nodes", "edges"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "graph_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "revision": {"type": "integer", "minimum": 0},
    "nodes": {"type": "array", "items": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/node"}]}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "duration": {"type": "integer", "minimum": 1},
        "execution_mode": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "dispatch_id": {"type": "string", "minLength": 1},
        "worktree_path": {"type": "string", "minLength": 1},
        "branch_name": {"type": "string", "minLength": 1},
        "base_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
        "plan_revision": {"type": "integer", "minimum": 1},
        "write_scope_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "active_conflicts_checked_at": {"type": "string", "minLength": 1},
        "isolation_status": {"type": "string", "enum": ["VERIFIED"]},
        "isolation_proof": {"$ref": "isolation-proof.schema.json"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["DEPENDENCY", "CONCURRENT", "MERGE", "CONFLICT_GROUP", "SHARED_WRITE_GROUP"]},
        "edge_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "edge_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "run_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "dispatch_id": {"type": "string", "minLength": 1},
        "worktree_path": {"type": "string", "minLength": 1},
        "branch_name": {"type": "string", "minLength": 1},
        "base_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
        "plan_revision": {"type": "integer", "minimum": 1},
        "write_scope_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "active_conflicts_checked_at": {"type": "string", "minLength": 1},
        "isolation_status": {"type": "string", "enum": ["VERIFIED"]},
        "isolation_proof": {"$ref": "isolation-proof.schema.json"}
      }
    }
  }
}
