{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "batch_id", "version", "title", "objective", "context", "owner", "depends_on", "execution_mode", "task_type", "requirement_ids", "read_scope", "write_scope", "inputs", "required_outputs", "acceptance_criteria", "verification", "out_of_scope", "risk_flags", "blocker_policy", "execution_budget", "architecture_decisions"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "batch_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "contract_mode": {"type": "string", "enum": ["legacy", "executable"]},
    "strict": {"type": "boolean"},
    "prerequisite_decisions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "exact_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "relevant_symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dependency_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "implementation_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validation_mode": {"type": "string", "enum": ["TDD", "ALTERNATIVE"]},
    "validation_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "red_required": {"type": "boolean"},
    "expected_red": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/definitions/expected_result"}]},
    "expected_green": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/definitions/expected_result"}]},
    "verification_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rollback_recovery_note": {"type": "string", "minLength": 1},
    "handoff_expectations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "file_responsibility_map": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/file_responsibility"}},
    "context": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "execution_mode": {"type": "string", "enum": ["auto", "async", "sync"]},
    "execution_policy": {"$ref": "execution-policy.schema.json"},
    "isolation_proof": {"$ref": "isolation-proof.schema.json"},
    "task_type": {"type": "string", "enum": ["backend", "frontend", "data", "infrastructure", "documentation", "testing", "review", "backend_change", "frontend_change", "data_change"]},
    "review_contract": {"$ref": "review-contract.schema.json"},
    "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "read_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "write_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "required_outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["criterion_id", "text", "requirement_ids"], "properties": {"criterion_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"}, "text": {"type": "string", "minLength": 1}, "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
    "verification": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verification_cases": {"type": "array", "items": {"$ref": "#/definitions/verification_case"}},
    "verification_exceptions": {"type": "array", "items": {"$ref": "#/definitions/verification_exception"}},
    "out_of_scope": {"type": "array", "items": {"type": "string"}},
    "risk_flags": {"$ref": "risk-flags.schema.json"},
    "shared_write_group": {"type": "string", "minLength": 1},
    "shared_write_approval_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "blocker_policy": {"type": "object", "required": ["hard_blockers"], "properties": {"hard_blockers": {"type": "array", "items": {"type": "string"}}}},
    "execution_budget": {"type": "object", "required": ["max_files_changed", "max_new_dependencies", "allow_schema_change", "allow_architecture_change"], "properties": {"max_files_changed": {"type": "integer", "minimum": 0}, "max_new_dependencies": {"type": "integer", "minimum": 0}, "allow_schema_change": {"type": "boolean"}, "allow_architecture_change": {"type": "boolean"}}},
    "architecture_decisions": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "expected_result": {
      "type": "object",
      "required": ["result"],
      "properties": {
        "result": {"type": "string", "minLength": 1},
        "failure_signature": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "file_responsibility": {
      "type": "object",
      "required": ["path", "owner", "concern"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "concern": {"type": "string", "minLength": 1},
        "symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "verification_case": {
      "type": "object",
      "required": ["verification_case_id", "acceptance_criterion_ids", "verification_type", "red_required", "status"],
      "properties": {
        "verification_case_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "acceptance_criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "verification_type": {"type": "string", "minLength": 1},
        "red_required": {"type": "boolean"},
        "red_command": {"type": ["string", "null"], "minLength": 1},
        "red_exit_code": {"type": ["integer", "null"], "minimum": 0},
        "red_failure_signature": {"type": ["string", "null"]},
        "red_workspace_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "red_recorded_at": {"type": ["string", "null"]},
        "green_command": {"type": ["string", "null"], "minLength": 1},
        "green_exit_code": {"type": ["integer", "null"], "minimum": 0},
        "green_workspace_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "green_recorded_at": {"type": ["string", "null"]},
        "broad_command": {"type": ["string", "null"], "minLength": 1},
        "broad_exit_code": {"type": ["integer", "null"], "minimum": 0},
        "broad_workspace_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "verified_at": {"type": ["string", "null"]},
        "run_id": {"type": ["string", "null"], "minLength": 1},
        "attempt_id": {"type": ["string", "null"], "minLength": 1},
        "task_revision": {"type": ["integer", "null"], "minimum": 1},
        "status": {"type": "string", "enum": ["PLANNED", "RED", "GREEN", "BROAD", "COMPLETE", "EXCEPTION", "STALE"]}
      },
      "additionalProperties": false
    },
    "verification_exception": {
      "type": "object",
      "required": ["exception_id", "type", "reason", "authority", "alternative_verification"],
      "properties": {
        "exception_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "type": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "authority": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object"}]},
        "alternative_verification": {"oneOf": [{"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, {"type": "object"}]},
        "expires_at": {"type": "string", "minLength": 1},
        "follow_up": {"type": "string", "minLength": 1},
        "applies_to": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  }
}
