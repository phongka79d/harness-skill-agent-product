{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "owner", "run_id", "acquired_at", "last_heartbeat", "lease_seconds", "expires_at"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "owner": {"type": "string", "minLength": 1},
    "owner_pid": {"type": "integer", "minimum": 1},
    "owner_identity": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "acquired_at": {"type": "string", "minLength": 1},
    "last_heartbeat": {"type": "string", "minLength": 1},
    "lease_seconds": {"type": "integer", "minimum": 1},
    "expires_at": {"type": "string", "minLength": 1}
  }
}
