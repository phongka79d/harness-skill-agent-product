{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "examples"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "examples": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["expected_result", "kind"],
        "properties": {
          "expected_result": {"type": "string", "enum": ["PASS", "REJECT", "BLOCKED", "RECOVERY_PENDING", "DOCUMENTATION_ONLY"]},
          "kind": {"type": "string", "enum": ["RUNTIME", "DOCUMENTATION_ONLY"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
