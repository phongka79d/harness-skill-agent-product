{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["error_id", "classification", "message", "operation_id"],
  "properties": {
    "error_id": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "enum": ["REVISION_CONFLICT", "EVENT_CONFLICT", "OWNERSHIP_CONFLICT", "NETWORK_UNCERTAIN", "NEEDS_RECONCILIATION", "STORE_BUSY"]},
    "message": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "reconcile_path": {"type": "string", "minLength": 1},
    "expected_revision": {"type": "integer", "minimum": 0},
    "current_revision": {"type": "integer", "minimum": 0},
    "expected_etag": {"type": "string"},
    "current_etag": {"type": "string"}
  }
}
