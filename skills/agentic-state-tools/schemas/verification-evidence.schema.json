{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["evidence_id", "verification_case_id", "task_id", "plan_revision", "run_id", "attempt_id", "task_revision", "phase", "verification_type", "workspace_hash", "command", "exit_code", "status", "recorded_at", "acceptance_criterion_ids"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "verification_case_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "task_revision": {"type": "integer", "minimum": 1},
    "phase": {"type": "string", "enum": ["RED", "GREEN", "BROAD", "FOCUSED", "LINT", "TYPECHECK", "UNIT", "INTEGRATION", "BUILD", "PACKAGING", "REQUIREMENT_COVERAGE"]},
    "verification_type": {"type": "string", "minLength": 1},
    "workspace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_commit": {"type": "string", "minLength": 1},
    "relevant_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "command": {"type": "string", "minLength": 1},
    "exit_code": {"type": ["integer", "null"], "minimum": 0},
    "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED", "NOT_APPLICABLE", "NOT_RUN", "BLOCKED"]},
    "failure_signature": {"type": ["string", "null"]},
    "output": {"type": ["string", "null"]},
    "stdout": {"type": ["string", "null"]},
    "stderr": {"type": ["string", "null"]},
    "output_digest": {"type": "string", "minLength": 1},
    "evidence_location": {"type": "string", "minLength": 1},
    "failure_category": {"type": "string", "minLength": 1},
    "expected_failure": {"type": "boolean"},
    "not_applicable_reason": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "acceptance_criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
