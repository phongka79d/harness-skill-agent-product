{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "status",
    "summary",
    "files_changed",
    "verification",
    "risks",
    "execution_receipt"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "BLOCKED",
        "ESCALATED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_receipt": {
      "type": "object",
      "required": [
        "status",
        "task_id",
        "workflow_decision_hash",
        "stage",
        "role",
        "attempt",
        "max_attempts",
        "repair_rounds",
        "max_repair_rounds",
        "outcome",
        "evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "COMPLETED",
            "BLOCKED",
            "ESCALATED"
          ]
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "workflow_decision_hash": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "plan_task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "NONE",
            "SYNTHESIZED FALLBACK",
            "BLOCKED"
          ]
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "repair_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "max_repair_rounds": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "next_step": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
