{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "status"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "read_scope": {"type": "array", "items": {"type": "string"}},
    "write_scope": {"type": "array", "items": {"type": "string"}},
    "risk_flags": {"$ref": "risk-flags.schema.json"},
    "shared_write_group": {"type": "string", "minLength": 1},
    "shared_write_approval_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "investigation_id": {"type": "string", "minLength": 1, "pattern": "^DBG-[A-Za-z0-9._-]+$"},
    "lease_id": {"type": "string", "minLength": 1},
    "worktree_path": {"type": "string", "minLength": 1},
    "branch_name": {"type": "string", "minLength": 1},
    "input_artifact_hashes": {"type": "object"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["PENDING", "READY", "QUEUED", "QUEUED_ASYNC", "QUEUED_SYNC", "WAITING", "WAITING_DEPENDENCY", "WAITING_RESOURCE_LOCK", "RUNNING", "CHECKPOINTED", "COMPLETED", "REVIEWING", "REPAIR_REQUIRED", "ACCEPTED", "BLOCKED", "PAUSED", "STALE", "RECOVERY_PENDING", "RESUMING", "DEFERRED", "ABORTED_UNSAFE", "ESCALATED", "ARCHIVED", "CANCELLED", "SUPERSEDED"]},
    "revision": {"type": "integer", "minimum": 1},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "superseded_by_revision": {"type": "integer", "minimum": 1},
    "superseded_by_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "invalidated_at": {"type": "string", "minLength": 1},
    "invalidated_artifacts": {"type": "array", "items": {"type": "string"}},
    "previous_revision": {"type": ["integer", "null"], "minimum": 0},
    "updated_at": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "review_verdict": {"type": "string", "enum": ["PASS", "BLOCKED", "REPAIR_REQUIRED"]},
    "progress": {},
    "checkpoint": {},
    "error": {},
    "blocker": {},
    "result_summary": {},
    "output_artifact_hashes": {"type": "object"},
    "review_contract": {"$ref": "review-contract.schema.json"},
    "next_action": {"type": "string"},
    "blockers": {"type": "array"}
  }
}
