{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "status_revision",
    "work_revision",
    "workflow_decision_hash",
    "profile_id",
    "profile_hash",
    "task_route",
    "execution_depth",
    "approval_reference",
    "status",
    "summary",
    "scope",
    "risk_flags",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
    },
    "status_revision": {
      "type": "integer",
      "minimum": 1
    },
    "work_revision": {
      "type": "integer",
      "minimum": 1
    },
    "workflow_decision_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "task_route": {
      "type": "string",
      "minLength": 1
    },
    "execution_depth": {
      "type": "string",
      "enum": [
        "focused",
        "standard",
        "controlled"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "TODO",
        "IN_PROGRESS",
        "BLOCKED",
        "COMPLETED",
        "ACCEPTED",
        "CANCELLED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
    },
    "plan_bundle_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "plan_review_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "acceptance_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]{0,127}"}
    },
    "worktree_identity": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "task_id",
        "path",
        "branch",
        "base_commit",
        "head_commit",
        "workflow_decision_hash",
        "repo_path"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
        },
        "path": {
          "type": "string",
          "pattern": "^\\.phongka/worktrees/[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "branch": {
          "type": "string",
          "pattern": "^phongka/task/[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "base_commit": {
          "type": "string",
          "pattern": "[0-9a-f]{40,64}"
        },
        "head_commit": {
          "type": "string",
          "pattern": "[0-9a-f]{40,64}"
        },
        "workflow_decision_hash": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "repo_path": {
          "type": "string",
          "pattern": "^\\.$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
