{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "status"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["PENDING", "READY", "QUEUED", "QUEUED_ASYNC", "QUEUED_SYNC", "WAITING", "WAITING_DEPENDENCY", "WAITING_RESOURCE_LOCK", "RUNNING", "CHECKPOINTED", "COMPLETED", "REVIEWING", "REPAIR_REQUIRED", "ACCEPTED", "BLOCKED", "PAUSED", "STALE", "RECOVERY_PENDING", "RESUMING", "DEFERRED", "ABORTED_UNSAFE", "ESCALATED", "ARCHIVED", "CANCELLED", "SUPERSEDED"]},
    "revision": {"type": "integer", "minimum": 1},
    "previous_revision": {"type": ["integer", "null"], "minimum": 0},
    "updated_at": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "review_verdict": {"type": "string", "enum": ["PASS", "BLOCKED", "REPAIR_REQUIRED"]},
    "review_contract": {"$ref": "review-contract.schema.json"},
    "next_action": {"type": "string"},
    "blockers": {"type": "array"}
  }
}
