{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolution_id", "task_id", "review_id", "finding_id", "run_id", "attempt_id", "task_revision", "status", "owner", "rationale", "evidence", "created_at", "revision"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "resolution_id": {"type": "string", "minLength": 1, "pattern": "^RES-[A-Za-z0-9._-]+$"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "review_id": {"type": "string", "minLength": 1},
    "finding_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "task_revision": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["ACCEPTED", "REJECTED_WITH_EVIDENCE", "NEEDS_CLARIFICATION", "SUPERSEDED", "FIXED_PENDING_REREVIEW", "CLOSED"]},
    "owner": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "previous_resolution_id": {"type": ["string", "null"], "minLength": 1},
    "previous_status": {"type": ["string", "null"], "enum": ["ACCEPTED", "REJECTED_WITH_EVIDENCE", "NEEDS_CLARIFICATION", "SUPERSEDED", "FIXED_PENDING_REREVIEW", "CLOSED", null]},
    "rationale": {"type": "string", "minLength": 1},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["summary"], "properties": {"summary": {"type": "string", "minLength": 1}, "references": {"type": "array", "items": {"type": "string", "minLength": 1}}, "workspace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "correction": {"type": ["object", "null"], "additionalProperties": false, "properties": {"summary": {"type": "string", "minLength": 1}, "changed_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "commit": {"type": "string", "minLength": 1}}},
    "verification": {"type": ["object", "null"], "additionalProperties": false, "properties": {"command": {"type": "string", "minLength": 1}, "exit_code": {"type": "integer", "minimum": 0}, "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "re_review": {"type": ["object", "null"], "additionalProperties": false, "properties": {"review_id": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]}}},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1}
  }
}
