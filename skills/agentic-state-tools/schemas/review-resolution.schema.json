{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "resolution_id", "task_id", "review_id", "original_review_id",
    "finding_id", "artifact_identity", "run_id", "attempt_id", "task_revision",
    "status", "owner", "actor", "actor_role", "finding", "contract_verification",
    "code_verification", "conflict_usage_check", "ambiguity_resolution", "rationale",
    "evidence", "created_at", "updated_at", "revision"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "resolution_id": {"type": "string", "minLength": 1, "pattern": "^RES-[A-Za-z0-9._-]+$"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "review_id": {"type": "string", "minLength": 1},
    "original_review_id": {"type": "string", "minLength": 1},
    "finding_id": {"type": "string", "minLength": 1},
    "artifact_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_revision", "run_id", "attempt_id", "dispatch_id", "workspace_hash", "artifact_hash"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "task_revision": {"type": "integer", "minimum": 1},
        "run_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "dispatch_id": {"type": "string", "minLength": 1},
        "workspace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "task_revision": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["ACCEPTED", "REJECTED_WITH_EVIDENCE", "NEEDS_CLARIFICATION", "SUPERSEDED", "FIXED_PENDING_REREVIEW", "CLOSED"]},
    "owner": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "actor_role": {"type": "string", "enum": ["IMPLEMENTER", "REVIEWER"]},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "evidence", "required_change"],
      "properties": {
        "severity": {"type": "string", "enum": ["CRITICAL", "MAJOR", "MINOR", "SUGGESTION"]},
        "evidence": {"type": "string", "minLength": 1},
        "required_change": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1}
      }
    },
    "contract_verification": {
      "type": "object", "additionalProperties": false, "required": ["status", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["VERIFIED", "CONFLICT"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "code_verification": {
      "type": "object", "additionalProperties": false, "required": ["status", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["VERIFIED", "CONFLICT"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "conflict_usage_check": {
      "type": "object", "additionalProperties": false, "required": ["status", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["CLEAR", "CONFLICT"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ambiguity_resolution": {
      "type": "object", "additionalProperties": false, "required": ["status", "decision", "evidence"],
      "properties": {
        "status": {"type": "string", "enum": ["RESOLVED", "NOT_REQUIRED", "UNRESOLVED"]},
        "decision": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rationale": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["summary"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "workspace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "rejection_basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "clarification_question": {"type": "string", "minLength": 1},
    "superseded_by": {"type": "string", "minLength": 1},
    "correction": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "coherent": {"type": "boolean"},
        "changed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "targeted_verification": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "workspace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "correction_reference": {"type": "string", "minLength": 1},
    "re_review": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "review_id": {"type": "string", "minLength": 1},
        "result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "previous_resolution_id": {"type": ["string", "null"], "minLength": 1},
    "previous_status": {"type": ["string", "null"], "enum": ["ACCEPTED", "REJECTED_WITH_EVIDENCE", "NEEDS_CLARIFICATION", "SUPERSEDED", "FIXED_PENDING_REREVIEW", "CLOSED", null]},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1}
  }
}
