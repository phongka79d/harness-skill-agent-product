{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "queue_id", "revision", "tasks"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "queue_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "revision": {"type": "integer", "minimum": 0},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "queue_state", "execution_mode", "dependency_snapshot", "scope_snapshot", "owner", "revision"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
          "queue_state": {"type": "string", "enum": ["READY", "BLOCKED", "CONFLICTED", "DISPATCHED", "RUNNING", "WAITING", "COMPLETED", "STALE"]},
          "execution_mode": {"type": "string", "enum": ["AUTO", "ASYNC", "SYNC", "auto", "async", "sync"]},
          "dependency_snapshot": {"type": "object", "required": ["depends_on", "accepted_task_ids"], "properties": {"depends_on": {"type": "array", "items": {"type": "string"}}, "accepted_task_ids": {"type": "array", "items": {"type": "string"}}}},
          "scope_snapshot": {"type": "object", "required": ["write_scope"], "properties": {"write_scope": {"type": "array", "items": {"type": "string"}}}},
          "owner": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 0},
          "run_id": {"type": "string", "minLength": 1},
          "attempt_id": {"type": "string", "minLength": 1},
          "dispatch_id": {"type": "string", "minLength": 1},
          "worktree_path": {"type": "string", "minLength": 1},
          "branch_name": {"type": "string", "minLength": 1},
          "base_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
          "plan_revision": {"type": "integer", "minimum": 1},
          "write_scope_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "active_conflicts_checked_at": {"type": "string", "minLength": 1},
          "isolation_status": {"type": "string", "enum": ["VERIFIED"]},
          "isolation_proof": {"$ref": "isolation-proof.schema.json"}
        }
      }
    },
    "task_states": {"type": "array"},
    "dispatches": {"type": "array"},
    "locks": {"type": "array"},
    "active_write_scopes": {"type": "array", "items": {"type": "string"}},
    "accepted_task_ids": {"type": "array", "items": {"type": "string"}}
  }
}
