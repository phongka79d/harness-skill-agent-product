{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["event_id", "timestamp", "type", "actor"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EVT-[0-9]{6,}$"},
    "timestamp": {"type": "string", "minLength": 1},
    "type": {"type": "string", "enum": ["TASK_PENDING", "TASK_READY", "TASK_QUEUED", "TASK_QUEUED_ASYNC", "TASK_QUEUED_SYNC", "TASK_WAITING", "TASK_WAITING_DEPENDENCY", "TASK_WAITING_RESOURCE_LOCK", "TASK_STARTED", "TASK_CHECKPOINTED", "TASK_COMPLETED", "TASK_REVIEWING", "TASK_ACCEPTED", "TASK_REPAIR_REQUIRED", "TASK_BLOCKED", "TASK_CANCELLED", "TASK_SUPERSEDED", "TASK_PAUSED", "TASK_STALE", "TASK_RECOVERY_PENDING", "TASK_RESUMING", "TASK_DEFERRED", "TASK_ABORTED_UNSAFE", "TASK_ESCALATED", "TASK_ARCHIVED", "BATCH_CONTRACT_CREATED", "BATCH_REVIEW_CREATED", "CHECKPOINT_CREATED", "CONTEXT_CREATED", "HANDOFF_CREATED", "REVIEW_CREATED", "LOCK_ACQUIRED", "LOCK_RELEASED", "LOCK_RECLAIMED", "APPROVAL_RECORDED", "HEARTBEAT_RECORDED", "LEASE_RELEASED", "OPERATION_RECORDED", "RECOVERY_INSPECTED", "ROLLBACK_PLANNED", "COMPENSATION_RECORDED", "ROLLBACK_ESCALATED", "ARTIFACT_INVALIDATED", "DEBUG_INVESTIGATION_CREATED", "VERIFICATION_EVIDENCE_RECORDED"]},
    "actor": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "data": {"type": "object"}
  }
}
