{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["review_id", "batch_id", "task_reviews", "integration_checks", "findings", "verdict"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "task_reviews": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "integration_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "result", "evidence"],
        "properties": {
          "kind": {"type": "string", "enum": ["integration", "regression", "scope"]},
          "name": {"type": "string", "minLength": 1},
          "result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
            "evidence": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {
                  "type": "object",
                  "required": ["evidence_id", "command", "exit_code", "status", "workspace_hash"],
                  "properties": {
                    "evidence_id": {"type": "string", "minLength": 1},
                    "command": {"type": "string", "minLength": 1},
                    "exit_code": {"type": ["integer", "null"], "minimum": 0},
                    "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED", "NOT_APPLICABLE", "NOT_RUN", "BLOCKED"]},
                    "workspace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "task_id": {"type": "string", "minLength": 1},
                    "run_id": {"type": "string", "minLength": 1},
                    "attempt_id": {"type": "string", "minLength": 1},
                    "task_revision": {"type": "integer", "minimum": 1}
                  }
                }
              ]
            }
        }
      }
    },
    "findings": {"type": "array", "items": {"type": "object", "required": ["severity", "evidence", "required_change"], "properties": {"severity": {"type": "string", "enum": ["CRITICAL", "MAJOR", "MINOR", "SUGGESTION"]}, "evidence": {"type": "string", "minLength": 1}, "required_change": {"type": "string", "minLength": 1}, "resolved": {"type": "boolean"}}}},
    "hard_fail_checks": {"type": "array", "items": {"type": "object", "required": ["rule", "triggered", "evidence"], "properties": {"rule": {"type": "string", "minLength": 1}, "triggered": {"type": "boolean"}, "evidence": {"type": "string", "minLength": 1}}}},
    "scope_valid": {"type": "boolean"},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "batch_contract_revision": {"type": "integer", "minimum": 1},
    "batch_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resolved_rubric": {"type": "object"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_status": {"type": "string", "enum": ["VERIFIED", "LEGACY_UNVERIFIED", "REJECTED"]},
    "review_contract": {"$ref": "review-contract.schema.json"},
    "legacy_migration": {"type": "boolean"},
    "verdict": {"type": "string", "enum": ["PASS", "REPAIR_REQUIRED", "BLOCKED", "PLAN_INVALID"]}
  }
}
