{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_decision_hash",
    "tasks",
    "review_mode",
    "review_rubric_id",
    "review_rubric_version",
    "criteria",
    "outcome",
    "summary",
    "findings",
    "workspace",
    "workspace_summary",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "workflow_decision_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "work_revision",
          "task_workflow_decision_hash"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
          },
          "work_revision": {
            "type": "integer",
            "minimum": 1
          },
          "task_workflow_decision_hash": {
            "type": "string",
            "pattern": "[0-9a-f]{64}"
          }
        },
        "additionalProperties": false
      }
    },
    "review_mode": {
      "type": "string",
      "enum": [
        "integration"
      ]
    },
    "review_rubric_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
    },
    "review_rubric_version": {
      "type": "integer",
      "minimum": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_APPLICABLE"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "PASS",
        "REPAIR_REQUIRED",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "summary",
          "location",
          "evidence",
          "impact",
          "correction"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "correction": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "size",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "[0-9a-f]{64}"
              }
            },
            "additionalProperties": false
          }
        },
        "worktree": {
          "type": "object",
          "required": [
            "task_id",
            "path",
            "branch",
            "base_commit",
            "head_commit",
            "workflow_decision_hash",
            "repo_path"
          ],
          "properties": {
            "task_id": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "branch": {"type": "string", "minLength": 1},
            "base_commit": {"type": "string", "minLength": 1},
            "head_commit": {"type": "string", "minLength": 1},
            "workflow_decision_hash": {"type": "string", "minLength": 1},
            "repo_path": {"type": "string", "pattern": "^\\.$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "workspace_summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
