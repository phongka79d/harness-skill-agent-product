{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "work_revision",
    "workflow_decision_hash",
    "status",
    "claim_hash",
    "verified_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
    },
    "work_revision": {
      "type": "integer",
      "minimum": 1
    },
    "workflow_decision_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS"
      ]
    },
    "claim_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "verified_at": {
      "type": "string",
      "minLength": 1
    },
    "plan_task_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"},
    "plan_bundle_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "plan_review_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "acceptance_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]{0,127}"}}
  },
  "additionalProperties": false
}
