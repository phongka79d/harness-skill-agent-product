{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "plan_id", "plan_revision", "plan_hash", "plan_approval_id", "batch_id", "batch_revision", "tasks", "review_contract", "rubric_id", "rubric_version", "rubric_hash", "revision", "previous_revision", "created_at", "contract_hash"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "contract_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "plan_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_approval_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "batch_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "batch_revision": {"type": "integer", "minimum": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "task_revision", "review_contract_hash", "rubric_id", "rubric_version", "rubric_hash"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
          "task_revision": {"type": "integer", "minimum": 1},
          "review_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rubric_id": {"type": "string", "minLength": 1},
          "rubric_version": {"type": "string", "minLength": 1},
          "rubric_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "review_contract": {"$ref": "review-contract.schema.json"},
    "rubric_id": {"type": "string", "minLength": 1},
    "rubric_version": {"type": "string", "minLength": 1},
    "rubric_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "integer", "minimum": 1},
    "previous_revision": {"type": ["integer", "null"], "minimum": 0},
    "created_at": {"type": "string", "minLength": 1},
    "contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
