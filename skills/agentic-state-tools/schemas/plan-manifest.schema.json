{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "plan_bundle_hash",
    "plan_task_ids",
    "acceptance_ids",
    "bundle"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "task_id": {"type": "string", "minLength": 1},
    "workflow_decision_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "plan_bundle_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "plan_path": {
      "type": "string",
      "pattern": "^\\.phongka/plan/\\d{4}-\\d{2}-\\d{2}-[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "plan_docs_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "plan_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"}
    },
    "acceptance_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]{0,127}"}
    },
    "bundle": {"type": "object"},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
