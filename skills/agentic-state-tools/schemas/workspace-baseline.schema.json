{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_id",
    "task_id",
    "run_id",
    "worktree_path",
    "branch",
    "base_commit",
    "workspace_hash",
    "setup_command",
    "setup_exit_code",
    "baseline_commands",
    "baseline_results",
    "known_failures",
    "status",
    "captured_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "baseline_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "worktree_path": {"type": "string", "minLength": 1},
    "worktree_root": {"type": ["string", "null"]},
    "branch": {"type": "string", "minLength": 1},
    "base_branch": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "head_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
    "workspace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "is_isolated": {"type": "boolean"},
    "ownership_verified": {"type": "boolean"},
    "owner": {"type": ["string", "null"]},
    "setup_command": {"type": "string", "minLength": 1},
    "setup_exit_code": {"type": ["integer", "null"], "minimum": 0},
    "setup_status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED", "BLOCKED"]},
    "setup_output": {"type": ["string", "null"]},
    "setup_output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "setup_failure_signature": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "baseline_commands": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "baseline_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/result"}
    },
    "known_failures": {
      "type": "array",
      "items": {"$ref": "#/$defs/known_failure"}
    },
    "approved_known_failures": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "profile_id": {"type": ["string", "null"], "minLength": 1},
    "blocking_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "status": {"type": "string", "enum": ["CLEAN", "KNOWN_FAILURES_APPROVED", "BLOCKED"]},
    "captured_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "result": {
      "type": "object",
      "required": ["command", "exit_code", "status", "output_digest", "recorded_at"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"type": ["integer", "null"], "minimum": 0},
        "status": {"type": "string", "enum": ["PASS", "FAIL", "SKIPPED", "BLOCKED"]},
        "stdout": {"type": ["string", "null"]},
        "stderr": {"type": ["string", "null"]},
        "output": {"type": ["string", "null"]},
        "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "failure_signature": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "approved_known_failure": {"type": "boolean"},
        "recorded_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "known_failure": {
      "type": "object",
      "required": ["signature", "command", "exit_code", "approved", "reason"],
      "properties": {
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"type": ["integer", "null"], "minimum": 0},
        "approved": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
