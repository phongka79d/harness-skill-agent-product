{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "path",
    "branch",
    "base_commit",
    "head_commit",
    "workflow_decision_hash",
    "repo_path"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
    },
    "path": {
      "type": "string",
      "pattern": "^\\.phongka/worktrees/[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "branch": {
      "type": "string",
      "pattern": "^phongka/task/[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "base_commit": {
      "type": "string",
      "pattern": "[0-9a-f]{40,64}"
    },
    "head_commit": {
      "type": "string",
      "pattern": "[0-9a-f]{40,64}"
    },
    "workflow_decision_hash": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "repo_path": {
      "type": "string",
      "pattern": "^\\.$"
    }
  },
  "additionalProperties": false
}
