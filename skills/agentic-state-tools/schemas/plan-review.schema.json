{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "review_mode",
    "review_rubric_id",
    "review_rubric_version",
    "outcome",
    "plan_bundle_hash",
    "plan_review_hash",
    "criteria",
    "acceptance_ids"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "task_id": {"type": "string", "minLength": 1},
    "workflow_decision_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "review_mode": {"type": "string", "enum": ["plan"]},
    "review_rubric_id": {"type": "string", "minLength": 1},
    "review_rubric_version": {"type": "integer", "minimum": 1},
    "outcome": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "plan_bundle_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "plan_review_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "acceptance_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "[A-Za-z0-9][A-Za-z0-9._:-]{0,127}"}
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_APPLICABLE"]},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "reviewed_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
