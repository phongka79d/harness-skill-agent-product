{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "operation_id",
    "operation_type",
    "idempotency_key",
    "status",
    "expected_revisions",
    "target_files",
    "staged_files",
    "started_at",
    "committed_at",
    "rollback_reason",
    "evidence"
  ],
  "properties": {
    "operation_id": {"type": "string", "minLength": 1, "pattern": "^OP-[A-Za-z0-9._-]+$"},
    "operation_type": {"type": "string", "minLength": 1, "pattern": "^[A-Z][A-Z0-9._-]*$"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["PREPARED", "APPLYING", "COMMITTED", "ROLLED_BACK", "RECOVERY_PENDING"]},
    "expected_revisions": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "target_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "staged_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_path", "staged_path", "previous_hash", "staged_hash", "target_hash"],
        "properties": {
          "target_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "staged_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "previous_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "staged_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "target_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "started_at": {"type": "string", "minLength": 1},
    "committed_at": {"type": ["string", "null"], "minLength": 1},
    "rollback_reason": {"type": ["string", "null"], "minLength": 1},
    "commit_marker": {"type": ["string", "null"], "minLength": 1},
    "rollback_marker": {"type": ["string", "null"], "minLength": 1},
    "evidence": {
      "type": "object",
      "required": ["classification", "phase", "previous_hashes", "target_hashes", "staged_hashes"],
      "properties": {
        "classification": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "previous_hashes": {"type": "object", "additionalProperties": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}},
        "target_hashes": {"type": "object", "additionalProperties": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}},
        "staged_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "previous_files": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "errors": {"type": "array", "items": {"type": "string"}},
        "last_error": {"type": "string"},
        "recovered_at": {"type": "string"}
      }
    }
  }
}
