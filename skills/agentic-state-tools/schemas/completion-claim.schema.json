{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["claim_id", "claim", "task_id", "plan_revision", "run_id", "attempt_id", "task_revision", "workspace_hash", "profile_id", "change_kind"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "claim": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "task_revision": {"type": "integer", "minimum": 1},
    "workspace_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relevant_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "change_kind": {"type": "string", "minLength": 1},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "test_harness_available": {"type": "boolean"},
    "broad_required": {"type": "boolean"},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/acceptance_mapping"}
    },
    "acceptance_criterion_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "acceptance_evidence_mapping": {
      "type": "array",
      "items": {"$ref": "#/definitions/acceptance_mapping"}
    },
    "verification_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "exceptions": {
      "type": "array",
      "items": {"$ref": "#/definitions/verification_exception"}
    },
    "summary": {"type": "string", "minLength": 1},
    "legacy_migration": {"type": "boolean"}
  },
  "definitions": {
    "acceptance_mapping": {
      "type": "object",
      "required": ["criterion_id", "evidence_ids"],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"type": "string", "enum": ["PASS", "NOT_APPLICABLE"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "verification_exception": {
      "type": "object",
      "required": ["exception_id", "type", "reason", "authority", "alternative_verification"],
      "properties": {
        "exception_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "type": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "authority": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object"}]},
        "alternative_verification": {"oneOf": [{"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, {"type": "object"}]},
        "expires_at": {"type": "string", "minLength": 1},
        "follow_up": {"type": "string", "minLength": 1},
        "applies_to": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
