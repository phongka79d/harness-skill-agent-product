{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["checkpoint_id", "task_id", "created_at", "current_step", "pending_steps"],
  "properties": {
    "checkpoint_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "task_revision": {"type": "integer", "minimum": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "input_artifact_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "created_at": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "current_step": {"type": "string", "minLength": 1},
    "pending_steps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "resume_safe": {"type": "boolean"},
    "files_modified": {"type": "array", "items": {"type": "string"}},
    "base_commit": {"type": "string", "minLength": 1},
    "workspace_status": {"type": "string", "enum": ["CLEAN", "CHANGED", "NOT_A_REPOSITORY", "UNAVAILABLE"]},
    "workspace_snapshot": {"type": "object"},
    "workspace_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
