{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["requested_mode", "resolved_mode", "resolution_reason", "resolved_by", "resolved_at", "isolation_proof"],
  "properties": {
    "requested_mode": {"type": "string", "enum": ["SYNC", "SYNC_WRITE", "AUTO", "PARALLEL_READ_ONLY", "ASYNC_PREFERRED", "ASYNC_REQUIRED", "ASYNC_ISOLATED_WRITE"]},
    "resolved_mode": {"type": ["string", "null"], "enum": ["SYNC", "SYNC_WRITE", "PARALLEL_READ_ONLY", "ASYNC", "ASYNC_ISOLATED_WRITE", "BLOCKED", null]},
    "resolution_reason": {"type": ["string", "null"], "minLength": 1},
    "resolved_by": {"type": ["string", "null"], "minLength": 1},
    "resolved_at": {"type": ["string", "null"], "minLength": 1},
    "isolation_proof": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
