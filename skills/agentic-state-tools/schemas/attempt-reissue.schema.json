{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "reason", "new_run_id", "new_attempt_id", "new_dispatch_id", "expected_revision"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "reason": {"type": "string", "minLength": 1},
    "new_run_id": {"type": "string", "minLength": 1},
    "new_attempt_id": {"type": "string", "minLength": 1},
    "new_dispatch_id": {"type": "string", "minLength": 1},
    "expected_revision": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
