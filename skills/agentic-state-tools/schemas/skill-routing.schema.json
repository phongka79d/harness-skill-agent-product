{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_route", "execution_depth", "state_mode", "verification_level",
    "allows_source_editing", "decision_hash", "approval", "delivery",
    "runtime_actions", "ordered_skills", "optional_skills"
  ],
  "properties": {
    "task_route": {"type": "string", "minLength": 1},
    "execution_depth": {"type": "string", "enum": ["focused", "standard", "controlled"]},
    "state_mode": {"type": "string", "enum": ["off", "optional", "required"]},
    "verification_level": {"type": "string", "enum": ["focused", "standard", "strict"]},
    "allows_source_editing": {"type": "boolean"},
    "decision_hash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "approval": {"type": "object"},
    "delivery": {"type": "object"},
    "runtime_actions": {"type": "object"},
    "ordered_skills": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "optional_skills": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
