{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "evidence_id", "plan_id", "ledger_id", "classification", "reasons", "created_at", "evidence_hash"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "ledger_id": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "enum": ["ROLLED_BACK", "PARTIAL_ROLLBACK", "ESCALATED"]},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "minLength": 1},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
