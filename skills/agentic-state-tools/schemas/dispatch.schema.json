{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["dispatch_id", "task_id", "agent_role", "selected_mode", "selected_owner", "selected_model", "input_revisions", "approval_references", "evidence"],
  "properties": {
    "dispatch_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "lease_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "agent_role": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "selected_mode": {"type": "string", "enum": ["ASYNC", "SYNC"]},
    "selected_owner": {"type": "string", "minLength": 1},
    "selected_model": {"type": "string", "minLength": 1, "description": "Must match the selected agent_role after resolving the agentic-configuration deployment overlay."},
    "risk_flags": {"$ref": "risk-flags.schema.json"},
    "input_revisions": {"type": "object"},
    "approval_references": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "object"},
    "status": {"type": "string", "enum": ["RECORDED"]},
    "idempotency_key": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "task_revision": {"type": "integer", "minimum": 1},
    "operation_id": {"type": "string", "minLength": 1}
  }
}
