{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["plan_id", "version", "title", "objective", "in_scope", "out_of_scope", "architecture", "workstreams", "milestones", "dependencies", "constraints", "success_criteria", "risks", "completion_conditions"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "items": {"type": "object", "required": ["requirement_id", "description"], "properties": {"requirement_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}}},
    "in_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "architecture": {"type": "string", "minLength": 1},
    "workstreams": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "milestones": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "success_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "completion_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
