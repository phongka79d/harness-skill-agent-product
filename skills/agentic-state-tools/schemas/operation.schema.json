{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["operation_id", "task_id", "type", "status", "command", "recorded_at", "revision", "actor"],
  "properties": {
    "operation_id": {"type": "string", "minLength": 1, "pattern": "^OP-[A-Za-z0-9._-]+$"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "enum": ["DATABASE_MIGRATION", "EMAIL", "EXTERNAL_RESOURCE", "COMMIT", "PUSH", "DEPLOY", "DELETE", "DEPENDENCY_INSTALL", "SCHEMA_CHANGE", "OTHER"]},
    "operation_type": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["STARTED", "COMPLETED", "FAILED", "UNKNOWN", "PREPARED", "APPLYING", "COMMITTED", "ROLLED_BACK", "RECOVERY_PENDING"]},
    "phase": {"type": "string", "enum": ["PREPARE", "COMMIT", "ROLLBACK"]},
    "transaction_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit_marker": {"type": "string", "minLength": 1},
    "rollback_marker": {"type": "string", "minLength": 1},
    "expected_revisions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "target_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "staged_files": {"type": "array", "items": {"type": "object"}},
    "started_at": {"type": "string", "minLength": 1},
    "committed_at": {"type": ["string", "null"], "minLength": 1},
    "rollback_reason": {"type": ["string", "null"], "minLength": 1},
    "evidence": {"type": "object"},
    "prepared_writes": {"type": "array", "items": {"type": "object"}},
    "command": {"type": "string", "minLength": 1},
    "result_checksum": {"type": "string", "minLength": 1},
    "result_summary": {"type": "string"},
    "recorded_at": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "actor": {"type": "string", "minLength": 1}
  }
}
