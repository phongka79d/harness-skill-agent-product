{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "review_rubric_id",
    "review_rubric_version",
    "goal",
    "scope",
    "tasks",
    "acceptance",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        4
      ]
    },
    "review_rubric_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
    },
    "review_rubric_version": {
      "type": "integer",
      "minimum": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "review_rubric_id",
          "review_rubric_version",
          "objective",
          "files",
          "steps",
          "dependencies",
          "acceptance",
          "verification",
          "rollback"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "review_rubric_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{0,63}"
          },
          "review_rubric_version": {
            "type": "integer",
            "minimum": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "rollback": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
